{
  "_doc": "Southern Machinery unified brand standard for product decks. Change values here, never hard-code them in scripts. See references/brand-standard.md.",
  "brand_version": "SM-PPT-202309",
  "company": {
    "short_name": "Southern Machinery",
    "legal_name": "Shenzhen Southern Machinery Sales and Service Co., Ltd.",
    "deck_label": "Product Presentation",
    "website": "www.smthelp.com",
    "facebook": "https://www.facebook.com/autoinsertion",
    "linkedin": "https://cn.linkedin.com/in/smtsupplier"
  },
  "colors": {
    "primary": "#00A3B4",
    "primary_bright": "#00C5DA",
    "secondary": "#98B341",
    "title": "#2F5597",
    "muted": "#6E747A",
    "light_green": "#E9EFD6",
    "light_teal": "#E5F6F8",
    "white": "#FFFFFF",
    "ink": "#1F1F1F"
  },
  "fonts": {
    "latin_and_ea": "微软雅黑",
    "fallback_note": "Microsoft YaHei. Google Slides preview substitutes it; judge final fit in PowerPoint.",
    "title_pt": [28, 24, 22],
    "body_pt_min": 10,
    "body_pt_default": 14
  },
  "template": {
    "file": "assets/template/southern-machinery-template-202309.pptx",
    "slide_size": "16:9 (13.333 x 7.5 in)",
    "content_layout_from_slide": 1,
    "keep_slides_at_end": [4, 5],
    "keep_slides_names": ["Best After-sales service", "Welcome Inquiry"],
    "drop_slides": [0, 1, 2, 3],
    "header_band": "logo top-left, title centred in band x=1.85-9.45 in, y=0.05-0.63 in",
    "footer": "www.smthelp.com bottom-right (from master; never redraw)",
    "safe_area_in": {"left": 0.75, "top": 0.95, "right": 11.65, "bottom": 6.45}
  },
  "filename": {
    "pattern": "{keywords}-Southern-Machinery.pptx",
    "max_len": 110,
    "separator": "-",
    "rules": "English only, product category + model + 2-4 search keywords, no spaces or Chinese, Title-Case words"
  },
  "metadata": {
    "author": "Southern Machinery",
    "required": ["title", "subject", "keywords"]
  }
}
