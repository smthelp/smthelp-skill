{
  "rubric_version": "1.0.1",
  "updated": "2026-09-08",
  "framework": "E-E-A-T 四层 × 2026 生成式引擎逻辑（RAG 召回 → 打分重排 → 交叉验证）",
  "scale": {
    "min": 0,
    "max": 100,
    "agent_adjust_range": 10,
    "note": "脚本产出 baseline；Agent 可在 ±agent_adjust_range 内调整，必须在 data.json 的 dims[].adjust_reason 写明理由"
  },
  "grades": {
    "80-100": "GEO 就绪 — AI 可稳定识别并引用",
    "60-79": "半成品 — 站内可用，站外欠账",
    "40-59": "挂牌未营业 — 实体未被机器确认",
    "0-39": "隐形 — AI 基本无法自行召回"
  },
  "cap_rules": [
    {
      "id": "CAP-D1",
      "dimension": "D",
      "when": "independent_source_count < 3",
      "cap": 35,
      "reason": "2026 可信度分层要求 ≥3 个独立信源交叉验证，单信源占比 ≤8%；不足则 AI 无第三方可佐证"
    },
    {
      "id": "CAP-E1",
      "dimension": "E",
      "when": "nap_conflicts > 1 || mirror_domain_count > 1",
      "cap": 40,
      "reason": "实体消歧失败时，AI 无证据判断哪个是权威主站，权重被稀释"
    },
    {
      "id": "CAP-B1",
      "dimension": "B",
      "when": "jsonld_total == 0",
      "cap": 25,
      "reason": "无机器可读实体档案，AI 只能靠正文猜测实体身份"
    },
    {
      "id": "CAP-C1",
      "dimension": "C",
      "when": "content_freshness_days > 730",
      "cap": 45,
      "reason": "生成引擎对时间衰减的敏感度远高于传统搜索，两年以上内容几乎不被优先召回"
    }
  ],
